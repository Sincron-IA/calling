{
  "name": "@calling/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge do Calling: emite tokens da Gemini Live e implementa ask_agent chamando os agentes DG Claw.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
