# Calling — variaveis de ambiente
#
# NUNCA commite o .env de verdade. Use /sincron-env para sincronizar o arquivo
# criptografado. Este .env.example so descreve QUAIS variaveis existem.
#
# ---------------------------------------------------------------------------
# BRIDGE (server/) — roda na VPS, onde os agentes moram
# ---------------------------------------------------------------------------

# Chave da Gemini API (Google AI Studio: https://aistudio.google.com/apikey).
# Fica SO no servidor. O browser nunca a ve: o bridge emite um token efemero.
GEMINI_API_KEY=

# Segredo compartilhado entre o app e o bridge. Gere um valor longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLING_SHARED_SECRET=

# Porta do bridge.
PORT=8787

# Interface em que o bridge escuta. O padrao e 127.0.0.1: so localhost alcanca
# (tunel SSH ou proxy reverso na mesma maquina). Mude apenas se voce decidir
# conscientemente expor o bridge — 0.0.0.0 abre para toda a rede.
# CALLING_BIND_HOST=127.0.0.1

# Origens permitidas no CORS, separadas por virgula. Inclua a URL publica do
# app (Vercel, tunel do Cloudflare) e o endereco do Vite em dev.
#
# Loopback anda em trio: para o navegador, http://localhost:5173 e
# http://127.0.0.1:5173 sao origens DIFERENTES, mesmo caindo na mesma maquina.
# O bridge resolve isso sozinho — ao ver um endereco de loopback na lista, ele
# libera as tres grafias (localhost, 127.0.0.1 e [::1]) naquela mesma porta.
# Voce nao precisa repetir as tres aqui.
#
# PORTA, porem, e literal: se o 5173 estiver ocupado o Vite sobe no 5174 e
# aquela origem NAO esta liberada. Acrescente a porta nova nesta linha.
# Quando uma origem e recusada, o log diz exatamente qual foi:
#   grep '"event":"cors_rejected"' /var/log/calling-bridge/current.log | jq .
CALLING_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://calling-bridge.sincronia.digital

# --- Log do bridge -------------------------------------------------------
# Um JSON por linha (NDJSON), em arquivo, com rodizio por tamanho.
# Padroes: /var/log/calling-bridge, 5 MB por arquivo, 5 arquivos (teto 25 MB).
# CALLING_LOG_DIR=/var/log/calling-bridge
# CALLING_LOG_LEVEL=info
# CALLING_LOG_MAX_SIZE=5m
# CALLING_LOG_MAX_FILES=4

# Modelo do Claude Code usado nas chamadas headless dos agentes.
CALLING_AGENT_MODEL=sonnet

# Caminho do binario do Claude Code na VPS.
CLAUDE_BIN=/home/massari/.local/bin/claude

# Timeout (ms) de uma pergunta ao agente. Voz pede resposta rapida.
CALLING_AGENT_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# CHAMADAS RECEBIDAS — um agente tocando o Calling (POST /api/ring)
# ---------------------------------------------------------------------------

# Credencial PROPRIA de cada agente: e ela que diz ao bridge QUEM esta ligando.
# Nao e o CALLING_SHARED_SECRET (esse e do app no browser) e nao mora no
# agents.json (que e publico no GitHub). Uma linha por agente, com o slug em
# maiusculas. Gere cada valor com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Agente sem a linha correspondente simplesmente nao consegue tocar.
CALLING_RING_TOKEN_AUTOMA=
CALLING_RING_TOKEN_IVO=
CALLING_RING_TOKEN_THEO=
CALLING_RING_TOKEN_BRAVO=
CALLING_RING_TOKEN_FLOW=
CALLING_RING_TOKEN_VETOR=

# Quanto tempo (ms) o toque fica de pe antes de virar "no_answer".
# Padrao 30000. Existe sobretudo para testes: mudar aqui ja muda o relogio da
# UI tambem, porque o servidor manda o `expiresAt` de cada toque.
# CALLING_RING_TIMEOUT_MS=30000

# Modelo e voz da Gemini Live (opcionais — ha padrao no codigo).
# CALLING_GEMINI_MODEL=
# CALLING_GEMINI_VOICE=
# CALLING_GEMINI_LANGUAGE=pt-BR

# ---------------------------------------------------------------------------
# WEB (web/) — build do Vite. So variaveis VITE_* chegam ao browser.
# NUNCA coloque GEMINI_API_KEY aqui: viraria codigo publico.
# ---------------------------------------------------------------------------

# URL publica do bridge. Precisa ser HTTPS quando o app roda na Vercel.
VITE_BRIDGE_URL=http://localhost:8787

# Mesmo valor de CALLING_SHARED_SECRET. Atencao: em um app de browser isto
# fica visivel para quem abrir o app — por isso o bridge e de uso pessoal
# (Luiz e Matheus) e deve ficar atras de rede/proxy restrito.
VITE_CALLING_SHARED_SECRET=
