{
  "name": "calling",
  "version": "0.1.0",
  "private": true,
  "description": "Ligacao por voz com os agentes DG Claw, usando a Gemini Live API como camada de audio.",
  "license": "MIT",
  "workspaces": [
    "web",
    "server",
    "electron"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "typecheck": "npm run typecheck --workspace=web && npm run typecheck --workspace=server",
    "start:server": "npm run start --workspace=server",
    "electron": "npm run start --workspace=electron"
  },
  "engines": {
    "node": ">=20"
  }
}
